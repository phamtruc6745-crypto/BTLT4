<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#F8C8DC;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#BCE3F5;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#bg)" rx="14"/>
  <!-- Cup body -->
  <rect x="130" y="130" width="140" height="170" rx="12" fill="rgba(255,255,255,0.6)" stroke="#F0A5C0" stroke-width="3"/>
  <!-- Cup top (wider) -->
  <rect x="115" y="120" width="170" height="20" rx="8" fill="rgba(255,255,255,0.7)" stroke="#F0A5C0" stroke-width="2"/>
  <!-- Straw -->
  <rect x="195" y="60" width="12" height="100" rx="6" fill="#5ab4e8" opacity="0.8"/>
  <!-- Drink content -->
  <rect x="133" y="175" width="134" height="120" rx="0 0 12 12" fill="rgba(248,200,220,0.55)"/>
  <!-- Bubbles inside drink -->
  <circle cx="160" cy="230" r="12" fill="rgba(90,50,30,0.6)"/>
  <circle cx="200" cy="250" r="14" fill="rgba(60,30,15,0.65)"/>
  <circle cx="238" cy="225" r="11" fill="rgba(90,50,30,0.6)"/>
  <circle cx="175" cy="265" r="10" fill="rgba(60,30,15,0.55)"/>
  <circle cx="220" cy="270" r="12" fill="rgba(90,50,30,0.6)"/>
  <!-- Text -->
  <text x="200" y="330" text-anchor="middle" font-family="Arial,sans-serif" font-size="16" fill="#7a2c4a" font-weight="600">🧋 Trúc's Tea</text>
  <text x="200" y="355" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#888" opacity="0.8">Ảnh đang cập nhật...</text>
</svg>
